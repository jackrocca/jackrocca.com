    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "google-auth-library": "^11.0.2",
    "jose": "^6.1.0",
    "lucide-react": "^0.577.0",
    "next": "16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
