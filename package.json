    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.9.6",
    "sharp": "0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
