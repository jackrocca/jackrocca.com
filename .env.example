# Generate independent, random secrets (at least 32 characters).
SESSION_SECRET=
CRON_SECRET=
# Connect a private Vercel Blob store to populate this automatically.
BLOB_READ_WRITE_TOKEN=
# Optional isolated namespace for local integration testing only.
# LEAGUE_STORAGE_PREFIX=pick4/test-unique-name

# Google OAuth web client: openid, email, profile only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OWNER_EMAIL=jrocca98@gmail.com
APP_URL=http://localhost:3106

# Photography: environment-specific private Blob prefix; local export directory.
# PHOTO_STORAGE_PREFIX=photography/development
# PHOTO_LOCAL_DIR=/absolute/path/to/website/work/photography

# Publication is disabled until the explicit upload/deployment approval gates pass.
PHOTO_PUBLICATION_ENABLED=false
PHOTO_STORAGE_DRIVER=blob
# Set separately per Vercel environment; preview must never select production.
# PHOTO_PUBLICATION_ENV=preview
# Use a dedicated private gallery bucket, separate from originals and league data.
PHOTO_R2_ACCOUNT_ID=
PHOTO_R2_BUCKET=
PHOTO_R2_ACCESS_KEY_ID=
PHOTO_R2_SECRET_ACCESS_KEY=
# Independent publisher token, at least 32 random characters. Store the same value
# in the Mac's Keychain, never browser code. Rotation rejects the previous token.
PHOTO_PUBLISHER_TOKEN=

# Private Atlas access requires BOTH pins, independent of league roles.
# Obtain the subject from the existing verified Google identity; never auto-enroll.
ATLAS_OWNER_EMAIL=
ATLAS_OWNER_GOOGLE_SUB=

# Private Atlas command gateway. Server-only; never use NEXT_PUBLIC_ names.
# Environment must match VERCEL_ENV; preview cannot target production.
ATLAS_CONTROL_ORIGIN=
ATLAS_CONTROL_ENVIRONMENT=
ATLAS_CONTROL_GATEWAY_TOKEN=
